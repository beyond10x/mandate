{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RotateRefreshCredential response",
  "description": "Present a refresh credential at the token endpoint and receive its successor (fork F6). The id is resolved by the trusted adapter from the presented refresh token; it is not a selector a caller chooses.",
  "x-ess-name": "mandate.identity.RotateRefreshCredential",
  "x-ess-kind": "command-response",
  "type": "object",
  "properties": {
    "refresh_credential_id": {
      "$ref": "#/$defs/mandate.core.RefreshCredentialId"
    },
    "refresh_credential": {
      "$ref": "#/$defs/mandate.core.CredentialSecret"
    },
    "session_id": {
      "$ref": "#/$defs/mandate.core.SessionId"
    }
  },
  "required": [
    "refresh_credential_id",
    "refresh_credential",
    "session_id"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "mandate",
    "specification_version": "v1",
    "source_digest": "ed30f4be9ac91f32de4da849d406533e9444bf70425bbe0c0312187b27df62b7",
    "contract_digest": "slice-sha256/2:8014259f38130254a4367f48253341173e1d2db1a03be98a79a14f1c4e65265d",
    "regenerate": "ess generate"
  },
  "$defs": {
    "mandate.core.CredentialSecret": {
      "title": "CredentialSecret",
      "x-ess-name": "mandate.core.CredentialSecret",
      "x-ess-kind": "newtype",
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "contentEncoding": "base64"
    },
    "mandate.core.RefreshCredentialId": {
      "title": "RefreshCredentialId",
      "x-ess-name": "mandate.core.RefreshCredentialId",
      "x-ess-kind": "newtype",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "mandate.core.SessionId": {
      "title": "SessionId",
      "x-ess-name": "mandate.core.SessionId",
      "x-ess-kind": "newtype",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  }
