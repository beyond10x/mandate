{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RotateRefreshCredential input",
  "description": "Present a refresh credential at the token endpoint and receive its successor (fork F6). The id is resolved by the trusted adapter from the presented refresh token; it is not a selector a caller chooses.",
