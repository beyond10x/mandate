      "title": "CredentialProof",
      "x-ess-name": "mandate.core.CredentialProof",
      "x-ess-kind": "newtype",
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
