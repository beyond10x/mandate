  "x-ess-kind": "command-input",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/mandate.core.RefreshCredentialId"
    },
    "refresh_proof": {
      "$ref": "#/$defs/mandate.core.CredentialProof"
    },
    "client_id": {
      "$ref": "#/$defs/mandate.core.OAuthClientId"
    }
  },
  "required": [
    "id",
    "refresh_proof",
    "client_id"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "mandate",
    "specification_version": "v1",
    "source_digest": "fe7572f53936b5997c3bd119e2453943039ed1a53748b3db2385206257a79cd2",
    "contract_digest": "slice-sha256/2:80a55bf85f4621c576f7a493c75e8200fd46e4be4bd9c678f51804e99449ee04",
    "regenerate": "ess generate"
  },
  "$defs": {
