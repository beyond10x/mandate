{
  "format": "mandate-obligations/1",
  "crate": "mandate-graph",
  "domains": [
    "mandate.graph"
  ],
  "commands": [
    {
      "command": "mandate.graph.DeregisterResource",
      "status": "implemented",
      "clauses": [
        {
          "clause": "Caller lacks resource registration/ownership authority",
          "tests": [],
          "blocked_on": "story:graph-policy-adapter"
        },
        {
          "clause": "the resource is outside the verified organization",
          "tests": [
            {
              "id": "mandate-graph::obligations::a_deregistration_of_another_organizations_resource_is_denied_like_an_unknown_one",
              "kind": "denial",
              "path": "double",
              "double": "mandate_graph::double::GraphDouble"
            }
          ],
          "blocked_on": "story:graph-policy-adapter"
        },
        {
          "clause": "a child resource still resolves through it",
          "tests": [
            {
              "id": "mandate-graph::double::a_resource_a_child_still_resolves_through_cannot_be_deregistered",
              "kind": "denial",
              "path": "double",
              "double": "mandate_graph::double::GraphDouble"
            }
          ],
          "blocked_on": "story:graph-policy-adapter"
        },
        {
          "clause": "the durable relationship cleanup this deregistration requires cannot be enqueued",
          "tests": [],
          "blocked_on": "decision-blocker:epoch-atomicity"
        }
      ],
      "no_state_change": [
        {
          "id": "mandate-graph::obligations::a_refused_deregistration_leaves_the_record_resolving_and_issues_no_revision",
          "kind": "no-state-change",
          "path": "double",
          "double": "mandate_graph::double::GraphDouble"
        }
      ],
      "blocked_on": "story:graph-policy-adapter",
      "denial_audit": {
        "status": "deferred",
        "blocker": "decision-blocker:audit-routing",
        "tests": []
      }
    },
    {
      "command": "mandate.graph.RegisterResource",
      "status": "implemented",
      "clauses": [
        {
          "clause": "Caller lacks resource registration/ownership authority",
          "tests": [],
          "blocked_on": "story:graph-policy-adapter"
        },
        {
          "clause": "parent is unresolved",
          "tests": [
            {
              "id": "mandate-graph::double::a_parent_that_does_not_resolve_is_denied",
              "kind": "denial",
              "path": "double",
              "double": "mandate_graph::double::GraphDouble"
            }
          ],
          "blocked_on": "story:graph-policy-adapter"
        },
        {
          "clause": "belongs to another organization",
          "tests": [
            {
              "id": "mandate-graph::obligations::a_registration_under_another_organizations_parent_is_denied_like_an_unknown_one",
              "kind": "denial",
              "path": "double",
              "double": "mandate_graph::double::GraphDouble"
            }
          ],
          "blocked_on": "story:graph-policy-adapter"
        },
        {
          "clause": "hierarchy admission fails",
          "tests": [],
          "blocked_on": "story:graph-policy-adapter"
        }
      ],
      "no_state_change": [
        {
          "id": "mandate-graph::obligations::a_refused_registration_records_no_resource_and_issues_no_revision",
          "kind": "no-state-change",
          "path": "double",
          "double": "mandate_graph::double::GraphDouble"
        }
      ],
      "blocked_on": "story:graph-policy-adapter",
      "denial_audit": {
        "status": "deferred",
        "blocker": "decision-blocker:audit-routing",
        "tests": []
      }
    },
    {
      "command": "mandate.graph.RemoveRelation",
      "status": "deferred",
      "story": "story:graph-policy-adapter",
      "blocker": "decision-blocker:backend",
      "clauses": [],
      "no_state_change": []
    },
    {
      "command": "mandate.graph.RevokeGrant",
      "status": "deferred",
      "story": "story:graph-policy-adapter",
      "blocker": "decision-blocker:backend",
      "clauses": [],
      "no_state_change": []
    },
    {
      "command": "mandate.graph.WriteRelationship",
      "status": "deferred",
      "story": "story:graph-policy-adapter",
      "blocker": "decision-blocker:backend",
      "clauses": [],
      "no_state_change": []
    }
  ],
  "addendum": [],
  "cases": [
    {
      "case": "graph-revocation",
      "tests": [
        {
          "id": "mandate-graph::revocation::inherited_access_is_denied_at_the_revision_the_grant_was_revoked_at",
          "kind": "denial",
          "path": "double",
          "double": "mandate_graph::double::GraphDouble"
        }
      ],
      "blocked_on": "story:graph-policy-adapter"
    }
  ]
}
