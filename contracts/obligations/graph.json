      "no_state_change": [
        {
          "id": "mandate-graph::obligations::a_relationship_write_refused_at_admission_records_no_relation_and_issues_no_revision",
          "kind": "no-state-change",
          "path": "double",
          "double": "mandate_graph::double::GraphDouble"
        }
