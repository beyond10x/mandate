        },
        {
          "clause": "revoked",
          "tests": [],
          "blocked_on": "decision-blocker:guards"
        },
        {
          "clause": "expired",
          "tests": [],
          "blocked_on": "decision-blocker:guards"
        },
        {
          "clause": "stale",
          "tests": [],
          "blocked_on": "decision-blocker:guards"
        },
        {
          "clause": "tenant",
          "tests": [
            {
              "id": "mandate-authz::context::a_subject_that_is_not_a_member_of_the_verified_organization_is_a_tenant_mismatch",
