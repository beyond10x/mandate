              "path": "double",
              "double": "mandate_graph::double::GraphDouble"
            }
          ],
          "blocked_on": "story:graph-policy-adapter"
        },
        {
          "clause": "policy",
          "tests": [
            {
              "id": "mandate-authz::evaluate::a_role_that_does_not_carry_the_requested_action_denies",
              "kind": "denial",
              "path": "real"
            },
            {
              "id": "mandate-authz::adversary_check_2::a_policy_deny_carrying_a_challenge_stays_a_deny",
              "kind": "denial",
              "path": "real"
            }
          ]
        },
        {
          "clause": "ceilings deny",
          "tests": [
            {
              "id": "mandate-authz::evaluate::a_ceiling_that_does_not_admit_the_action_refuses_an_otherwise_allowed_request",
              "kind": "denial",
              "path": "real"
            },
            {
              "id": "mandate-authz::obligations::a_ceiling_recorded_for_the_organization_refuses_an_action_the_grant_carries",
              "kind": "denial",
              "path": "real"
            }
          ]
        },
        {
          "clause": "approval is required",
          "tests": [
            {
              "id": "mandate-authz::check_contract::a_request_missing_a_required_approval_is_allowed_false_with_a_scoped_challenge",
              "kind": "denial",
              "path": "real"
            }
          ]
        },
        {
          "clause": "the required PDP",
          "tests": [
            {
              "id": "mandate-authz::check_contract::a_decision_point_that_cannot_answer_denies_and_invents_no_permission",
              "kind": "denial",
              "path": "real"
            },
            {
              "id": "mandate-authz::evaluate::a_policy_decision_point_that_cannot_answer_denies_a_request_the_graph_allows",
              "kind": "denial",
              "path": "real"
            }
          ]
        },
        {
          "clause": "graph",
          "tests": [
            {
              "id": "mandate-authz::obligations::a_graph_that_has_not_reached_the_required_revision_is_unavailable_and_not_a_denial",
              "kind": "denial",
              "path": "real"
            },
            {
              "id": "mandate-authz::evaluate::a_revision_the_reader_has_not_applied_is_unavailable_and_not_a_denial_about_the_caller",
              "kind": "denial",
              "path": "real"
            }
          ]
        },
        {
          "clause": "credential authority is unavailable",
          "tests": [],
          "blocked_on": "decision-blocker:guards"
        }
